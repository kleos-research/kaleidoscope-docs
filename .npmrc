# The Node pin in package.json `engines` is ADVISORY to npm by default: it
# warns EBADENGINE and installs anyway. Gate (d) claim 3 — "what is committed
# is a fresh build of the reviewed source" — has "a pinned toolchain" as its
# stated precondition, and an advisory pin does not honour it. This makes the
# pin refuse.
engine-strict=true

# The pin must satisfy the locked tree, not merely be recent: undici in this
# lockfile requires node >=22.19.0, and 22.12.0 refused to install because of
# it. A strict pin that contradicts its own lockfile fails closed, which is
# the correct behaviour and is how this was found.
