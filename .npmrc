# The Node pin in package.json `engines` is ADVISORY to npm by default: it
# warns EBADENGINE and installs anyway. Gate (d) claim 3 — "what is committed
# is a fresh build of the reviewed source" — has "a pinned toolchain" as its
# stated precondition, and an advisory pin does not honour it. This makes the
# pin refuse.
engine-strict=true
