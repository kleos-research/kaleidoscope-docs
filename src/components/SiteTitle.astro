---
/**
 * Replaces Starlight's SiteTitle. Carries the brand lockup AND the primary
 * nav, because this is the only header slot that renders on every route —
 * which is what puts the inline mark on all 38 pages, as the mark gate needs.
 *
 * Top nav is exactly four items: Home, Docs, Status, GitHub. The GitHub link
 * points at the ORG,
 * never at the product repository — the product repo's URL, with the closing
 * quote of an href attribute after it, is a PRIVATE_MARKERS entry, so linking
 * it fails the build. The trailing quote is what lets the org link through.
 */
const path = Astro.url.pathname;
const nav = [
  { label: 'Home', href: '/', match: (p: string) => p === '/' },
  { label: 'Docs', href: '/docs/', match: (p: string) => p.startsWith('/docs/') },
  { label: 'Status', href: '/status/', match: (p: string) => p === '/status/' },
  { label: 'GitHub', href: 'https://github.com/kleos-research', match: () => false },
];
---

<div class="k-lockup">
  <a href="/" class="site-title sl-flex">
    <svg class="kaleidoscope-mark" viewBox="0 0 64 64" width="18" height="18" aria-hidden="true"><g fill="currentColor">
    <rect x="4" y="16" width="28" height="7"/>
    <rect x="4" y="16" width="28" height="7" transform="rotate(90 32 32)" opacity="0.78"/>
    <rect x="4" y="16" width="28" height="7" transform="rotate(180 32 32)" opacity="0.56"/>
    <rect x="4" y="16" width="28" height="7" transform="rotate(270 32 32)" opacity="0.34"/>
    <rect x="28.5" y="28.5" width="7" height="7"/></g></svg>
    <span class="wordmark" translate="no">Kaleidoscope</span>
  </a>
  <nav class="k-nav" aria-label="Primary">
    {nav.map((item) => (
      <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
</div>
